\@writefile{toc}{\contentsline {section}{\numberline {7}Conclusion}{10}{figure.14}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Left: wall-clock time vs.\ number of assets $n$ (log--log scale, $T = 2n$, Ledoit-Wolf shrinkage applied throughout) for KKT direct, CG (matrix-free), and NNLS (Lawson--Hanson). Right: CG iteration counts vs.\ shrinkage intensity $\alpha $ at fixed $n=500$, $T=250$ (rank-deficient baseline). Larger $\alpha $ compresses the eigenvalue spectrum and reduces the condition number $\kappa (\Sigma _{\mathrm  {LW}})$, directly reducing CG iterations.}}{11}{figure.13}\protected@file@percent }
\newlabel{fig:scaling}{{1}{11}{Left: wall-clock time vs.\ number of assets $n$ (log--log scale, $T = 2n$, Ledoit-Wolf shrinkage applied throughout) for KKT direct, CG (matrix-free), and NNLS (Lawson--Hanson). Right: CG iteration counts vs.\ shrinkage intensity $\alpha $ at fixed $n=500$, $T=250$ (rank-deficient baseline). Larger $\alpha $ compresses the eigenvalue spectrum and reduces the condition number $\kappa (\Sigma _{\mathrm {LW}})$, directly reducing CG iterations}{figure.13}{}}
\newlabel{fig:scaling@cref}{{[figure][1][]1}{[1][10][]11}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Wall-clock time vs.\ number of assets $n$ (log--log scale, $T = 2n$, Ledoit-Wolf shrinkage applied throughout) for KKT direct, CG (matrix-free), and NNLS (Lawson--Hanson). KKT direct scales as $O(n^3)$; matrix-free CG scales empirically as $O(n^2)$ due to the iteration count growing slowly with the compressed spectrum; NNLS also scales as $O(n^3)$ (Lawson--Hanson normal equations). Reference slopes are anchored to the KKT curve at $n = 500$.}}{11}{figure.14}\protected@file@percent }
\newlabel{fig:loglog}{{2}{11}{Wall-clock time vs.\ number of assets $n$ (log--log scale, $T = 2n$, Ledoit-Wolf shrinkage applied throughout) for KKT direct, CG (matrix-free), and NNLS (Lawson--Hanson). KKT direct scales as $O(n^3)$; matrix-free CG scales empirically as $O(n^2)$ due to the iteration count growing slowly with the compressed spectrum; NNLS also scales as $O(n^3)$ (Lawson--Hanson normal equations). Reference slopes are anchored to the KKT curve at $n = 500$}{figure.14}{}}
\newlabel{fig:loglog@cref}{{[figure][2][]2}{[1][10][]11}{}{}{}}
