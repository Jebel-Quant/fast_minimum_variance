\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Portfolio construction problems solved by the same primal--dual loop. $b$ is the benchmark weight vector; $F$ contains factor returns; $D$ is a diagonal specific-risk matrix; $R$ is the $N\times N$ regularisation target matrix (e.g.\ $\sqrt  {\bar  \lambda }\,I$ for classical Ledoit-Wolf shrinkage, where $\bar  \lambda = \|X\|_F^2/(nT)$ is the mean eigenvalue of $\hat  \Sigma $). Stacking of $\tilde  {X}$ is in the row direction. $^*\min _w (w-b)^\top \Sigma (w-b) = \min _w w^\top \Sigma w - 2(\Sigma b)^\top w + \mathrm  {const}$, so $\rho \mu = 2\Sigma b = 2X^\top (Xb)$ (two matrix--vector products). Since $\mu = \Sigma b$, the second SPD solve yields $v_2 = b$ exactly; tracking error adds no inner-solve cost.}}{3}{table.4}\protected@file@percent }
\newlabel{tab:problems}{{2}{3}{Portfolio construction problems solved by the same primal--dual loop. $b$ is the benchmark weight vector; $F$ contains factor returns; $D$ is a diagonal specific-risk matrix; $R$ is the $N\times N$ regularisation target matrix (e.g.\ $\sqrt {\bar \lambda }\,I$ for classical Ledoit-Wolf shrinkage, where $\bar \lambda = \|X\|_F^2/(nT)$ is the mean eigenvalue of $\hat \Sigma $). Stacking of $\tilde {X}$ is in the row direction. $^*\min _w (w-b)^\top \Sigma (w-b) = \min _w w^\top \Sigma w - 2(\Sigma b)^\top w + \mathrm {const}$, so $\rho \mu = 2\Sigma b = 2X^\top (Xb)$ (two matrix--vector products). Since $\mu = \Sigma b$, the second SPD solve yields $v_2 = b$ exactly; tracking error adds no inner-solve cost}{table.4}{}}
\newlabel{tab:problems@cref}{{[table][2][]2}{[1][3][]3}{}{}{}}
