\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Left: wall-clock time vs.\ $n$ (log--log, $T=2n$, five sector caps, $\rho =0.5$, LW shrinkage throughout). Right: efficient frontier for $n=500$ assets with five sector caps, $\alpha =1/3$, tracing 51 risk--return points as $\rho $ varies from $0$ to $2$, computed with the KKT direct solver ($\alpha =1/3$) for illustration; MINRES+LW and CG+LW (same $\alpha $) produce the same curve to relative weight tolerance $10^{-4}$ over all 51 points (see \S  \ref {sec:frontier}).}}{11}{figure.8}\protected@file@percent }
\newlabel{fig:scaling}{{1}{11}{Left: wall-clock time vs.\ $n$ (log--log, $T=2n$, five sector caps, $\rho =0.5$, LW shrinkage throughout). Right: efficient frontier for $n=500$ assets with five sector caps, $\alpha =1/3$, tracing 51 risk--return points as $\rho $ varies from $0$ to $2$, computed with the KKT direct solver ($\alpha =1/3$) for illustration; MINRES+LW and CG+LW (same $\alpha $) produce the same curve to relative weight tolerance $10^{-4}$ over all 51 points (see \S \ref {sec:frontier})}{figure.8}{}}
\newlabel{fig:scaling@cref}{{[figure][1][]1}{[1][10][]11}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.4}S\&P~500 real-data benchmark}{11}{figure.8}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces S\&P~500 universe: $n=495$ assets, $T=1192$ trading days (July~2021--April~2026), long-only minimum-variance problem. Speedup relative to \texttt  {cvxpy} within each panel. Iterations are cumulative Krylov iterations across all active-set steps; \texttt  {cvxpy} interior-point iterations are not comparable to Krylov iterations (different cost per step) and are therefore omitted. $^*$KKT is a direct inner solve; the 7 active-set outer steps (each promoting a batch of assets whose unconstrained weight is negative to the long-only bound $w_i = 0$) are not shown.}}{12}{table.9}\protected@file@percent }
\newlabel{tab:sp500}{{3}{12}{S\&P~500 universe: $n=495$ assets, $T=1192$ trading days (July~2021--April~2026), long-only minimum-variance problem. Speedup relative to \texttt {cvxpy} within each panel. Iterations are cumulative Krylov iterations across all active-set steps; \texttt {cvxpy} interior-point iterations are not comparable to Krylov iterations (different cost per step) and are therefore omitted. $^*$KKT is a direct inner solve; the 7 active-set outer steps (each promoting a batch of assets whose unconstrained weight is negative to the long-only bound $w_i = 0$) are not shown}{table.9}{}}
